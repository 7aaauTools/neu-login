#!/bin/sh
# SPDX-License-Identifier: GPL-3.0-or-later
# Copyright (C) 2026 7aaau
# NetworkManager dispatcher: WiFi 连上 NEU 网络后立即登录 (秒级响应)
# 与 neu-login-check.timer 配合: 事件驱动保证响应速度, 定时巡检提供可靠性保障
# 安装位置: /etc/NetworkManager/dispatcher.d/90-neu-login (root:root, 755)
# 日志: journalctl -t neu-login
#
# 退出码约定 (与 neu_login.py 一致):
#   0 = 成功/已在线      2 = 网络暂时性失败(值得重试)   3 = 凭据/账号/配置错误(重试无意义)
# 认证被拒时脚本返回 3, 本脚本立即停止重试, 避免连续失败把账号试到锁定。
#
# 注意: NM 文档明确 —— connectivity-change 事件传入的网卡参数是**空串**,
#       只有 hostname 事件是 "none"。因此两种情况都要反查当前活动的无线连接。

IFACE="$1"
ACTION="$2"
LOGIN="/usr/bin/python3 /usr/local/bin/neu_login.py"

case "$ACTION" in
    up|connectivity-change) ;;
    *) exit 0 ;;
esac

if [ -z "$IFACE" ] || [ "$IFACE" = "none" ]; then
    # connectivity-change 事件: 反查当前活动的无线连接 (NM 未给具体网卡)
    act=$(nmcli -t -f NAME,DEVICE,TYPE connection show --active 2>/dev/null |
          grep ':802-11-wireless$' | head -1)
    [ -n "$act" ] || exit 0
    CONN=$(echo "$act" | cut -d: -f1)
    IFACE=$(echo "$act" | cut -d: -f2)
else
    case "$IFACE" in
        wlan*|wl*) ;;
        *) exit 0 ;;
    esac
    CONN=$(nmcli -t -f NAME,DEVICE connection show --active 2>/dev/null | grep ":$IFACE" | cut -d: -f1)
fi

# 确认活动连接是 NEU 网络
case "$CONN" in
    *NEU*) ;;
    *) exit 0 ;;
esac

# 等待 IP/DNS 就绪
sleep 3

logger -t neu-login "$ACTION $IFACE ($CONN), 触发校园网登录"

# 网络类失败最多尝试3次 (认证门户的启动可能晚于 DHCP 完成)
i=1
while [ "$i" -le 3 ]; do
    out=$($LOGIN 2>&1)
    rc=$?
    [ -n "$out" ] && echo "$out" | logger -t neu-login
    case "$rc" in
        0)
            logger -t neu-login "登录成功 (第${i}次尝试)"
            exit 0
            ;;
        3)
            logger -t neu-login "凭据/账号/配置错误(rc=3), 停止重试; 请检查密码/账号状态或设备数上限"
            exit 0
            ;;
    esac
    i=$((i + 1))
    [ "$i" -le 3 ] && sleep 8
done

logger -t neu-login "3次网络类尝试均失败, 等待下一轮定时巡检"
exit 1
